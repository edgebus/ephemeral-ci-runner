#!/bin/bash
#

#
# OpenRC:
#   ln --symbolic /var/lib/qemu-vms/qemu-builder/qemu-builder-windows11-amd64 /etc/local.d/qemu-builder-windows11-amd64.26_XX.start
#
# Systemd:
#   mkdir /etc/local.d
#   ln --symbolic /var/lib/qemu-vms/qemu-builder/qemu-builder-windows11-amd64 /etc/local.d/qemu-builder-windows11-amd64.26_XX.start
#   ... make job: systemctl start local-d.service
#

RUN_SCRIPT=$(basename "$0")

VM_SCRIPT=$(readlink --no-newline --canonicalize "$0")
VM_SCRIPT_NAME=$(basename "${VM_SCRIPT}")
VM_SCRIPT_DIR=$(dirname "${VM_SCRIPT}")

# Convert /etc/local.d/qemu-builder-windows11-amd64.26_XX.start -> 26_XX.start
RUN_SCRIPT_EXT=${RUN_SCRIPT#*.}

# Convert 26_XX.start -> 26_XX
INSTANCE_NAME=${RUN_SCRIPT_EXT%.start*}

# Convert 26_XX -> 26
INSTANCE_ID=$(echo "${INSTANCE_NAME}" | cut -f1 -d_)

#echo "INSTANCE_NAME: ${INSTANCE_NAME}"
#echo "INSTANCE_ID: ${INSTANCE_ID}"

if [ -n "${INSTANCE_ID}" -a -n "${INSTANCE_NAME}" ]; then
    BACKING_FILE="${VM_SCRIPT_DIR}/${VM_SCRIPT_NAME}-${INSTANCE_NAME}.qcow2"
    VM_NAME="${VM_SCRIPT_NAME}-${INSTANCE_NAME}"
    VM_STATE_DIR="${VM_SCRIPT_DIR}/${VM_SCRIPT_NAME}-${INSTANCE_NAME}.state"

    MAC_ADDRESS_LOW=$(printf '%02x\n' "${INSTANCE_ID}")
    MAC_ADDRESS="52:54:00:01:00:${MAC_ADDRESS_LOW}"
else
    BACKING_FILE="${VM_SCRIPT_DIR}/${VM_SCRIPT_NAME}.qcow2"
    VM_NAME="${VM_SCRIPT_NAME}"
    VM_STATE_DIR="${VM_SCRIPT_DIR}/${VM_SCRIPT_NAME}.state"

    INSTANCE_NAME="00"

    MAC_ADDRESS="52:54:00:01:00:00"
fi
echo "Resolved main VM '${VM_NAME}' using backing file '${BACKING_FILE}'."


VM_CONFIG=${VM_SCRIPT_DIR}/${VM_NAME}.conf

# echo RUN_SCRIPT: $RUN_SCRIPT
# echo VM_SCRIPT_NAME: $VM_SCRIPT_NAME
# echo VM_SCRIPT_DIR: $VM_SCRIPT_DIR
# echo VM_STATE_DIR: $VM_STATE_DIR
# echo VM_CONFIG: $VM_CONFIG
# echo VM_NAME: $VM_NAME
# echo USE_KVM: $USE_KVM

# echo BACKING_FILE: $BACKING_FILE
# file $BACKING_FILE

# echo
# ls --format=verbose $VM_SCRIPT_DIR

if [ -f "${VM_CONFIG}" ]; then
    source "${VM_CONFIG}"
fi

QEMU_OPTS=""

if [ "${USE_KVM}" == "yes" ]; then
    QEMU_OPTS="${QEMU_OPTS} -accel kvm"
    #QEMU_OPTS="${QEMU_OPTS} -enable-kvm"
fi

if [ -n "${CPU}" ]; then
    QEMU_OPTS="${QEMU_OPTS} -smp ${CPU}"
else
    QEMU_OPTS="${QEMU_OPTS} -smp 4"
fi

if [ -n "${CPU_FLAGS}" ]; then
    QEMU_OPTS="${QEMU_OPTS} -cpu ${CPU_FLAGS}"
else
    QEMU_OPTS="${QEMU_OPTS} -cpu max"
fi

if [ -n "${MEM}" ]; then
    QEMU_OPTS="${QEMU_OPTS} -m ${MEM}G"
else
    QEMU_OPTS="${QEMU_OPTS} -m 8G"
fi

if [ "${NETWORK}" == "bridge" ]; then
    QEMU_OPTS="${QEMU_OPTS} -device e1000e,netdev=vm_eth0,mac=${MAC_ADDRESS} -netdev -netdev bridge,id=vm_eth0"
    if [ -n "${RDP_FORWARD_PORT}" ]; then
        QEMU_OPTS="${QEMU_OPTS} -device e1000e,netdev=vm_eth1 -netdev user,id=vm_eth1,hostfwd=tcp:0.0.0.0:${RDP_FORWARD_PORT}-:3389"
    fi
else
    QEMU_OPTS="${QEMU_OPTS} -device e1000e,netdev=vm_eth0,mac=${MAC_ADDRESS}"
    if [ -n "${RDP_FORWARD_PORT}" ]; then
        QEMU_OPTS="${QEMU_OPTS} -netdev user,id=vm_eth0,hostname=${INSTANCE_NAME}.vm.tw02.in.zxteam.net,hostfwd=tcp:0.0.0.0:${RDP_FORWARD_PORT}-:3389"
    else
        QEMU_OPTS="${QEMU_OPTS} -netdev user,id=vm_eth0,hostname=${INSTANCE_NAME}.vm.tw02.in.zxteam.net"
    fi
fi

if [ -n "${VNC_DISPLAY}" ]; then
    QEMU_OPTS="${QEMU_OPTS} -display vnc=0.0.0.0:${VNC_DISPLAY},password=on -monitor stdio"
else
    QEMU_OPTS="${QEMU_OPTS} -nographic"
fi

QEMU_OPTS="${QEMU_OPTS} -monitor unix:/run/${VM_NAME}.sock,server,nowait"

if [ "${NO_SNAPSHOT}" != "yes" ]; then
    QEMU_OPTS="${QEMU_OPTS} -snapshot"
fi

if [ ! -d "${VM_STATE_DIR}" ]; then
    mkdir "${VM_STATE_DIR}"
fi

set -e

if [ ! -f "${VM_STATE_DIR}/OVMF_VARS.fd" ]; then
  cp -aL /usr/share/edk2/OvmfX64/OVMF_VARS.secboot.fd "${VM_STATE_DIR}/OVMF_VARS.fd"
fi

if [ ! -d "${VM_STATE_DIR}/tpm" ]; then
    mkdir "${VM_STATE_DIR}/tpm"
    swtpm_setup --tpm2 --tpmstate "${VM_STATE_DIR}/tpm"
fi

main() {

    logger --tag "${VM_SCRIPT_NAME}" "VM start"

    TPM_SOCKET="/tmp/swtpm-$$-${VM_NAME}.sock"
    swtpm socket --tpm2 --daemon --terminate --tpmstate dir="${VM_STATE_DIR}/tpm" --ctrl type=unixio,path="${TPM_SOCKET}"

    sleep 1
    while [ ! -S "${TPM_SOCKET}" ]; do
    echo "Wait for ${TPM_SOCKET} ..." >&2
    sleep 1
    done

    set -x

    qemu-system-x86_64 \
        ${QEMU_OPTS} \
        -machine q35 \
        -chardev socket,id=chrtpm,path="${TPM_SOCKET}" \
        -tpmdev emulator,id=tpm0,chardev=chrtpm \
        -device tpm-tis,tpmdev=tpm0 \
        -device nvme,drive=disk0,serial=1 \
        -device qemu-xhci \
        -device usb-tablet \
        -drive if=none,file=${BACKING_FILE},id=disk0 \
        -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2/OvmfX64/OVMF_CODE.secboot.fd \
        -drive if=pflash,format=raw,file="${VM_STATE_DIR}/OVMF_VARS.fd" \
        -name "${VM_NAME}"

    set +x

    logger --tag "${VM_SCRIPT_NAME}" "VM has been shutdown"

    sleep 5
}

if [ "$DEBUG" == "yes" ]; then
    main
    exit $?
else
    while true; do
        main
    done &
fi
